// LUMIHUB — Schema de banco de dados
// Sistema operacional interno da Lumière Agency

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// ORGANIZAÇÃO / MULTI-EMPRESA (Fase 45)
// Toda entidade pertence a uma Organization, permitindo múltiplas empresas
// isoladas na mesma implantação. User.email é único globalmente (não por
// organização) porque o login resolve a conta apenas pelo e-mail, sem pedir
// qual organização — cada pessoa pertence a exatamente uma organização.
// =========================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/Sao_Paulo")
  currency  String   @default("BRL")
  locale    String   @default("pt-BR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                         User[]
  roles                         Role[]
  auditLogs                     AuditLog[]
  leads                         Lead[]
  clients                       Client[]
  contractTemplates             ContractTemplate[]
  contracts                     Contract[]
  proposals                     Proposal[]
  pricingSettings               PricingSettings?
  commissions                   Commission[]
  projects                      Project[]
  tasks                         Task[]
  taskBoards                    TaskBoard[]
  teamMembers                   TeamMember[]
  services                      Service[]
  captures                      Capture[]
  calendarEvents                CalendarEvent[]
  financialCategories           FinancialCategory[]
  costCenters                   CostCenter[]
  financialMovements            FinancialMovement[]
  accountsReceivable            AccountReceivable[]
  accountsPayable               AccountPayable[]
  messageTemplates              MessageTemplate[]
  creditCards                   CreditCard[]
  investments                   Investment[]
  goals                         Goal[]
  alerts                        Alert[]
  notifications                 Notification[]
  documents                     Document[]
  integrations                  Integration[]
  integrationWebhooks           IntegrationWebhook[]
  integrationLogs               IntegrationLog[]
  aiConversations               AiConversation[]
  aiInsights                    AiInsight[]
  captureAssignments            CaptureAssignment[]
  mediaMembers                  MediaMember[]
  mediaFunctions                MediaFunction[]
  mediaInvitations              MediaInvitation[]
  mediaBrandSettings            MediaBrandSettings?
  mediaEvents                   MediaEvent[]
  mediaEventRecurrences         MediaEventRecurrence[]
  mediaEventDefaultRequirements MediaEventDefaultRequirement[]
  mediaSchedules                MediaSchedule[]
  mediaSwapRequests             MediaSwapRequest[]
  mediaOperationsSettings       MediaOperationsSettings?
  mediaAIGenerationRuns         MediaAIGenerationRun[]
  mediaActionTokens             MediaActionToken[]
  mediaPublicScheduleLink       MediaPublicScheduleLink?

  @@map("organizations")
}

// =========================================================================
// AUTENTICAÇÃO, RBAC E SEGURANÇA (Fase 1)
// =========================================================================

enum RoleKey {
  ADMIN
  FINANCEIRO
  OPERACAO
  COMERCIAL
  GESTAO
  CUSTOM
  // Role "casca vazia" exclusiva do shell user do Mídia ADESF (ver
  // ensureMediaOnlyRole em @/lib/media/bootstrap.ts). Nunca usar CUSTOM
  // aqui: CUSTOM é o slot único de "perfil personalizado" que o próprio
  // admin cria em Usuários e Permissões (@@unique([organizationId, key])),
  // e reaproveitá-lo para este shell colidia (P2002) sempre que a
  // organização já tinha um perfil personalizado seu.
  MEDIA_ONLY
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  key            RoleKey
  name           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]

  @@unique([organizationId, key])
  @@map("roles")
}

// Chaves granulares: <MODULE>_<ACTION>, ex: FINANCE_VIEW, FINANCE_CREATE, MANAGE_INTEGRATIONS
model Permission {
  id          String @id @default(cuid())
  key         String @unique
  module      String
  action      String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id              String    @id @default(cuid())
  organizationId  String
  roleId          String
  name            String
  email           String    @unique
  passwordHash    String
  avatarUrl       String?
  isActive        Boolean   @default(true)
  isOwner         Boolean   @default(false)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  // Preferências de notificação (categorias e horário de silêncio); nulo = padrão, tudo ligado.
  notificationSettings Json?
  // Perfis adicionais (a pessoa soma os acessos de todos) e ajustes aba por
  // aba ({ MODULO: "off" | "view" | "full" }) aplicados por cima dos perfis.
  extraRoleIds    String[]  @default([])
  moduleAccess    Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization              Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                      Role                      @relation(fields: [roleId], references: [id])
  pushSubscriptions         PushSubscription[]
  sessions                  Session[]
  passwordResets            PasswordResetToken[]
  auditLogs                 AuditLog[]
  ownedLeads                Lead[]                    @relation("LeadOwner")
  createdLeads              Lead[]                    @relation("LeadCreator")
  createdProposals          Proposal[]                @relation("ProposalCreator")
  commissions               Commission[]              @relation("CommissionSeller")
  paidCommissions           Commission[]              @relation("CommissionPayer")
  responsibleProjects       Project[]                 @relation("ProjectResponsible")
  assignedTasks             Task[]                    @relation("TaskAssignee")
  createdTasks              Task[]                    @relation("TaskCreator")
  taskBoardsCreated         TaskBoard[]               @relation("TaskBoardCreator")
  taskMemberships           TaskMember[]              @relation("TaskMembership")
  taskComments              TaskComment[]             @relation("TaskCommentAuthor")
  taskAttachments           TaskAttachment[]          @relation("TaskAttachmentCreator")
  teamMemberProfile         TeamMember?
  calendarEvents            CalendarEvent[]           @relation("EventResponsible")
  notifications             Notification[]
  documentsUploaded         Document[]
  aiConversations           AiConversation[]
  connectedIntegrations     Integration[]
  captureAssignments        CaptureAssignment[]
  mediaMember               MediaMember?
  mediaInvitationsSent      MediaInvitation[]         @relation("MediaInvitationInviter")
  mediaEventsCreated        MediaEvent[]              @relation("MediaEventCreatedBy")
  mediaSchedulesCreated     MediaSchedule[]           @relation("MediaScheduleCreatedBy")
  mediaSchedulesPublished   MediaSchedule[]           @relation("MediaSchedulePublishedBy")
  mediaAssignmentsAssigned  MediaScheduleAssignment[] @relation("MediaAssignmentAssignedBy")
  mediaSwapRequestsAsLeader MediaSwapRequest[]        @relation("MediaSwapLeader")
  mediaAttendanceMarked     MediaAttendance[]         @relation("MediaAttendanceMarkedBy")
  mediaAIGenerationRuns     MediaAIGenerationRun[]    @relation("MediaAIGenerationRequestedBy")

  @@index([organizationId])
  @@map("users")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Rastreia tentativas de login por e-mail e IP para rate limiting / brute force
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =========================================================================
// COMERCIAL — CRM E PROSPECÇÃO (Fase 4)
// =========================================================================

enum LeadStage {
  LEAD
  CONTATO
  QUALIFICADO
  REUNIAO
  PROPOSTA
  NEGOCIACAO
  FECHADO
  PERDIDO
}

// Sinal de prioridade do lead (§ pedido do usuário: ferramentas de captação
// externas — e a busca automática por prospects no YouTube — já entregam
// essa classificação pronta; antes só dava pra jogar em `notes` como texto
// solto, sem conseguir filtrar/ordenar por quem está mais "quente".
enum LeadTemperature {
  QUENTE
  MORNO
  FRIO
}

model Lead {
  id                String           @id @default(cuid())
  organizationId    String
  company           String
  contactName       String?
  phone             String?
  whatsapp          String?
  instagram         String?
  website           String?
  city              String?
  segment           String?
  source            String?
  temperature       LeadTemperature?
  ownerUserId       String?
  createdByUserId   String?
  potentialValue    Decimal?         @db.Decimal(14, 2)
  probability       Int              @default(0)
  stage             LeadStage        @default(LEAD)
  lastContactAt     DateTime?
  nextContactAt     DateTime?
  notes             String?
  convertedClientId String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           User?                 @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy       User?                 @relation("LeadCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  convertedClient Client?               @relation(fields: [convertedClientId], references: [id])
  proposals       Proposal[]
  services        LeadServiceInterest[]

  @@index([organizationId, stage])
  @@index([organizationId, createdByUserId])
  @@map("leads")
}

enum ProposalStatus {
  RASCUNHO
  ENVIADA
  EM_NEGOCIACAO
  ACEITA
  RECUSADA
  EXPIRADA
}

enum ProposalResponse {
  ACEITA
  AJUSTE
  RECUSADA
}

model Proposal {
  id              String            @id @default(cuid())
  organizationId  String
  leadId          String?
  clientId        String?
  createdByUserId String?
  title           String
  // Valor total estimado do contrato (pontual + mensal × meses mínimos) — o
  // que alimenta o pipeline. O detalhamento fica nos itens.
  value           Decimal           @db.Decimal(14, 2)
  status          ProposalStatus    @default(RASCUNHO)
  validUntil      DateTime?
  sentAt          DateTime?
  notes           String?
  // Orçamento com link (v2): quem recebe, como pagar e a resposta do cliente.
  publicToken     String?           @unique
  currency        String            @default("BRL")
  recipientName   String?
  recipientPhone  String?
  intro           String?
  discountPercent Decimal           @default(0) @db.Decimal(5, 2)
  maxInstallments Int?
  oneTimeTotal    Decimal?          @db.Decimal(14, 2)
  monthlyTotal    Decimal?          @db.Decimal(14, 2)
  minMonths       Int?
  pricingSnapshot Json?
  viewedAt        DateTime?
  lastViewedAt    DateTime?
  viewCount       Int               @default(0)
  response        ProposalResponse?
  responseMessage String?
  respondedAt     DateTime?
  chosenPayment   String?
  signerData      Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("ProposalCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items        ProposalItem[]
  contract     Contract?
  commissions  Commission[]

  @@index([organizationId, status])
  @@map("proposals")
}

enum ServiceBilling {
  MENSAL
  PONTUAL
}

enum CardPriceMode {
  AUTO
  FIXED
  NONE
}

// Linha do orçamento: guarda uma cópia do serviço no momento da proposta,
// para que editar o catálogo depois nunca mude um orçamento já enviado.
model ProposalItem {
  id                String         @id @default(cuid())
  proposalId        String
  serviceId         String?
  name              String
  tagline           String?
  features          String[]       @default([])
  billing           ServiceBilling @default(PONTUAL)
  quantity          Int            @default(1)
  unitPrice         Decimal        @db.Decimal(14, 2)
  monthlyFee        Decimal?       @db.Decimal(14, 2)
  priceIsFrom       Boolean        @default(false)
  cardMode          CardPriceMode  @default(AUTO)
  cardPrice         Decimal?       @db.Decimal(14, 2)
  maxInstallments   Int?
  minMonths         Int?
  terms             String?
  position          Int            @default(0)
  commissionPercent Decimal?       @db.Decimal(5, 2)
  commissionFixed   Decimal?       @db.Decimal(14, 2)
  // Eventos: metade da comissão no sinal, metade na quitação.
  commissionSplit   Boolean        @default(false)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([proposalId])
  @@map("proposal_items")
}

enum CommissionStatus {
  AGUARDANDO_CLIENTE
  A_PAGAR
  PAGA
  CANCELADA
}

// Comissão do comercial gerada quando o cliente aceita o orçamento. Fica
// "aguardando cliente" até a diretoria confirmar o pagamento, vira "a pagar"
// e depois "paga". Valor integral, de uma vez; só eventos dividem em
// sinal/quitação (stage).
model Commission {
  id             String           @id @default(cuid())
  organizationId String
  proposalId     String
  sellerUserId   String?
  stage          String           @default("INTEGRAL")
  description    String
  amount         Decimal          @db.Decimal(14, 2)
  breakdown      Json?
  status         CommissionStatus @default(AGUARDANDO_CLIENTE)
  releasedAt     DateTime?
  paidAt         DateTime?
  paidByUserId   String?
  cancelReason   String?
  // Folha (conta a pagar) em que esta comissão entra para ser paga.
  payableId      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal     Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  seller       User?        @relation("CommissionSeller", fields: [sellerUserId], references: [id], onDelete: SetNull)
  paidBy       User?        @relation("CommissionPayer", fields: [paidByUserId], references: [id], onDelete: SetNull)

  @@unique([proposalId, stage])
  @@index([organizationId, status])
  @@index([sellerUserId, status])
  @@map("commissions")
}

// Taxas da maquininha, margem do crédito e dados que entram no contrato —
// um registro por organização, editado pelo admin.
model PricingSettings {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  debitFee            Decimal  @default(0.94) @db.Decimal(6, 3)
  // [{ n: 1, seller: 2.84, buyer: 0 }, { n: 2, seller: 2.85, buyer: 9.64 }, ...]
  installmentFees     Json
  creditMargin        Decimal  @default(5) @db.Decimal(6, 3)
  maxInstallments     Int      @default(12)
  validityDays        Int      @default(7)
  pixKey              String?
  whatsappTemplate    String?
  contractTemplateMsg String?
  companyLegalName    String?
  companyDocument     String?
  companyAddress      String?
  companyCity         String?
  representativeName  String?
  representativeEmail String?
  representativeDoc   String?
  // Lumi Cobranças: agradecimento automático ao confirmar pagamento e Pix copia e cola em mensagem separada.
  billingThanks       Boolean  @default(true)
  // Cachês de captação: uma pessoa sozinha / cada pessoa quando há mais de uma.
  captureFeeSolo      Decimal  @default(100) @db.Decimal(10, 2)
  captureFeeShared    Decimal  @default(50) @db.Decimal(10, 2)
  // Simples Nacional: % sobre o que é recebido no mês, guia (DAS) no dia taxDueDay do mês seguinte.
  taxRate             Decimal  @default(6) @db.Decimal(6, 3)
  taxDueDay           Int      @default(20)
  billingPixSeparate  Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("pricing_settings")
}

// =========================================================================
// CLIENTES E CONTRATOS (Fase 5)
// =========================================================================

enum ClientStatus {
  ATIVO
  INATIVO
  PROSPECTO
  INADIMPLENTE
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  companyName    String
  cnpj           String?
  contactName    String?
  email          String?
  phone          String?
  address        String?
  instagram      String?
  website        String?
  status         ClientStatus @default(ATIVO)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  originLead         Lead?
  contracts          Contract[]
  proposals          Proposal[]
  projects           Project[]
  captures           Capture[]
  calendarEvents     CalendarEvent[]
  accountsReceivable AccountReceivable[]
  financialMovements FinancialMovement[]
  documents          Document[]
  tasks              Task[]
  services           ClientService[]

  @@index([organizationId, status])
  @@map("clients")
}

enum ContractType {
  CLIENTE
  FUNCIONARIO
  FREELANCER
  PRESTADOR
  UGC
  AUDIOVISUAL
  SOCIAL_MEDIA
  TRAFEGO
  DESIGN
  DESENVOLVIMENTO
  PERSONALIZADO
}

model ContractTemplate {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  type           ContractType
  bodyTemplate   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contracts    Contract[]

  @@map("contract_templates")
}

enum ContractStatus {
  RASCUNHO
  AGUARDANDO_ASSINATURA
  ATIVO
  ENCERRADO
  CANCELADO
}

enum RecurrenceType {
  UNICO
  MENSAL
  TRIMESTRAL
  ANUAL
}

model Contract {
  id                  String         @id @default(cuid())
  organizationId      String
  clientId            String
  templateId          String?
  title               String
  type                ContractType
  value               Decimal        @db.Decimal(14, 2)
  recurrence          RecurrenceType @default(UNICO)
  startDate           DateTime
  endDate             DateTime?
  paymentDay          Int?
  status              ContractStatus @default(RASCUNHO)
  fileUrl             String?
  generatedBody       String?
  signedAt            DateTime?
  proposalId          String?        @unique
  // Assinatura eletrônica (Autentique)
  signatureProvider   String?
  signatureDocumentId String?        @unique
  signatureLink       String?
  signatureSentAt     DateTime?
  signatureStatus     String?
  signatureSigners    Json?
  signedFileUrl       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template           ContractTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  proposal           Proposal?           @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  projects           Project[]
  accountsReceivable AccountReceivable[]
  financialMovements FinancialMovement[]
  calendarEvents     CalendarEvent[]

  @@index([organizationId, status])
  @@map("contracts")
}

// =========================================================================
// PROJETOS, TAREFAS, EQUIPE E CAPTAÇÕES (Fase 6)
// =========================================================================

enum ProjectStatus {
  BACKLOG
  PLANEJAMENTO
  EM_PRODUCAO
  EM_REVISAO
  AGUARDANDO_CLIENTE
  CONCLUIDO
  ATRASADO
}

model Project {
  id                String        @id @default(cuid())
  organizationId    String
  clientId          String
  contractId        String?
  name              String
  responsibleUserId String?
  status            ProjectStatus @default(BACKLOG)
  startDate         DateTime?
  dueDate           DateTime?
  value             Decimal?      @db.Decimal(14, 2)
  costEstimate      Decimal?      @db.Decimal(14, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contract           Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  responsible        User?               @relation("ProjectResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  tasks              Task[]
  team               ProjectTeamMember[]
  captures           Capture[]
  calendarEvents     CalendarEvent[]
  documents          Document[]
  financialMovements FinancialMovement[]

  @@index([organizationId, status])
  @@map("projects")
}

enum TaskStatus {
  A_FAZER
  EM_ANDAMENTO
  EM_REVISAO
  CONCLUIDA
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model Task {
  id              String       @id @default(cuid())
  organizationId  String
  projectId       String?
  boardId         String?
  listId          String?
  position        Float        @default(0)
  title           String
  description     String?
  assigneeUserId  String?
  status          TaskStatus   @default(A_FAZER)
  priority        TaskPriority @default(MEDIA)
  coverColor      String?
  // Imagem de capa do cartão (um anexo do próprio cartão).
  coverAttachmentId String?
  startDate       DateTime?
  dueDate         DateTime?
  clientId        String?
  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  completedAt     DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board        TaskBoard?            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  list         TaskList?             @relation(fields: [listId], references: [id], onDelete: SetNull)
  client       Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee     User?                 @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdBy    User?                 @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  labels       TaskLabelAssignment[]
  members      TaskMember[]
  checklist    TaskChecklistItem[]
  comments     TaskComment[]
  attachments  TaskAttachment[]

  @@index([organizationId, status])
  @@index([boardId, listId, position])
  @@map("tasks")
}

// Quadros estilo Trello: cada quadro tem listas (colunas) livres; cada lista
// diz a qual status ela "conta" para relatórios e para o dashboard.
model TaskBoard {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  color           String    @default("orange")
  position        Float     @default(0)
  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("TaskBoardCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lists        TaskList[]
  tasks        Task[]
  labels       TaskLabel[]

  @@index([organizationId])
  @@map("task_boards")
}

model TaskList {
  id        String     @id @default(cuid())
  boardId   String
  name      String
  status    TaskStatus @default(A_FAZER)
  position  Float      @default(0)
  createdAt DateTime   @default(now())

  board TaskBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId])
  @@map("task_lists")
}

model TaskLabel {
  id        String   @id @default(cuid())
  boardId   String
  name      String   @default("")
  color     String
  createdAt DateTime @default(now())

  board       TaskBoard             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  assignments TaskLabelAssignment[]

  @@index([boardId])
  @@map("task_labels")
}

model TaskLabelAssignment {
  taskId  String
  labelId String

  task  Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label TaskLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_label_assignments")
}

model TaskMember {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_members")
}

model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  text      String
  done      Boolean  @default(false)
  position  Float    @default(0)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklist_items")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation("TaskCommentAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model TaskAttachment {
  id              String   @id @default(cuid())
  taskId          String
  name            String
  url             String
  // Arquivo enviado (imagem, PDF, vídeo curto…) — vazio quando é só um link.
  storageKey      String?
  mimeType        String?
  size            Int?
  createdByUserId String?
  createdAt       DateTime @default(now())

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User? @relation("TaskAttachmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("task_attachments")
}

enum TeamMemberType {
  FUNCIONARIO
  FREELANCER
  PRESTADOR
}

enum PaymentMethod {
  PIX
  TRANSFERENCIA
  BOLETO
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
  OUTRO
}

model TeamMember {
  id             String         @id @default(cuid())
  organizationId String
  userId         String?        @unique
  name           String
  role           String
  type           TeamMemberType
  paymentValue   Decimal?       @db.Decimal(14, 2)
  paymentMethod  PaymentMethod?
  paymentDay     Int?
  // FIXED = dia do mês (paymentDay) · BUSINESS_DAY = Nº dia útil (paymentDay = N) · LAST_BUSINESS_DAY = último dia útil
  paymentDayMode String         @default("FIXED")
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  projects     ProjectTeamMember[]
  payables     AccountPayable[]

  @@map("team_members")
}

model ProjectTeamMember {
  projectId     String
  teamMemberId  String
  roleInProject String?
  costAllocated Decimal? @db.Decimal(14, 2)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@id([projectId, teamMemberId])
  @@map("project_team_members")
}

model Service {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  category       String?
  description    String?
  defaultPrice   Decimal? @db.Decimal(14, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Orçamentos: como o serviço é cobrado e aparece na proposta.
  billing           ServiceBilling @default(PONTUAL)
  currency          String         @default("BRL")
  tagline           String?
  features          String[]       @default([])
  badge             String?
  priceIsFrom       Boolean        @default(false)
  monthlyFee        Decimal?       @db.Decimal(14, 2)
  cardMode          CardPriceMode  @default(AUTO)
  cardPrice         Decimal?       @db.Decimal(14, 2)
  maxInstallments   Int?
  minMonths         Int?
  isAddon           Boolean        @default(false)
  terms             String?
  position          Int            @default(0)
  guideKey          String?
  // Comissão de quem vende: % sobre o valor de tabela (1ª mensalidade nos
  // planos mensais) ou valor fixo. Paga de uma vez, mesmo se o cliente parcelar.
  commissionPercent Decimal?       @db.Decimal(5, 2)
  commissionFixed   Decimal?       @db.Decimal(14, 2)
  // Eventos: metade da comissão no sinal, metade na quitação.
  commissionSplit   Boolean        @default(false)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads         LeadServiceInterest[]
  clients       ClientService[]
  proposalItems ProposalItem[]

  @@unique([organizationId, guideKey])
  @@index([organizationId])
  @@map("services")
}

model LeadServiceInterest {
  leadId    String
  serviceId String

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([leadId, serviceId])
  @@map("lead_service_interests")
}

model ClientService {
  clientId  String
  serviceId String
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([clientId, serviceId])
  @@map("client_services")
}

enum CaptureStatus {
  PLANEJADA
  CONFIRMADA
  REALIZADA
  EM_EDICAO
  ENTREGUE
}

model Capture {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  projectId      String?
  date           DateTime
  location       String?
  status         CaptureStatus @default(PLANEJADA)
  videomaker     String?
  photographer   String?
  storymaker     String?
  droneOperator  String?
  videoCount     Int?
  photoCount     Int?
  scriptNotes    String?
  equipment      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  calendarEvents CalendarEvent[]
  assignments    CaptureAssignment[]

  @@index([organizationId, status])
  @@map("captures")
}

// Aceite de escala (Fase 46): cada membro de equipe atribuído a uma
// captação recebe uma notificação e precisa aceitar ou recusar — o aceite
// confirma a presença dele na Agenda, sem precisar de app nativo/push.
enum CaptureAssignmentStatus {
  PENDENTE
  ACEITO
  RECUSADO
}

model CaptureAssignment {
  id             String                  @id @default(cuid())
  organizationId String
  captureId      String
  userId         String
  role           String
  status         CaptureAssignmentStatus @default(PENDENTE)
  respondedAt    DateTime?
  googleEventId  String?
  // Cachê da captação para esta pessoa (definido quando a captação é realizada; editável pelo admin).
  fee            Decimal?                @db.Decimal(14, 2)
  feeManual      Boolean                 @default(false)
  // Folha (conta a pagar) em que este cachê entra.
  payableId      String?
  createdAt      DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capture      Capture      @relation(fields: [captureId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([captureId, userId, role])
  @@index([userId, status])
  @@map("capture_assignments")
}

// =========================================================================
// CALENDÁRIO (Fase 7)
// =========================================================================

enum CalendarEventType {
  CAPTACAO
  REUNIAO
  ENTREGA
  VENCIMENTO
  COBRANCA
  CONTRATO
  TAREFA
  INTERNO
  MIDIA
}

model CalendarEvent {
  id                String            @id @default(cuid())
  organizationId    String
  title             String
  type              CalendarEventType
  startAt           DateTime
  endAt             DateTime?
  allDay            Boolean           @default(false)
  clientId          String?
  projectId         String?
  captureId         String?
  contractId        String?
  mediaEventId      String?           @unique
  responsibleUserId String?
  location          String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  capture      Capture?     @relation(fields: [captureId], references: [id], onDelete: Cascade)
  contract     Contract?    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  mediaEvent   MediaEvent?  @relation(fields: [mediaEventId], references: [id], onDelete: Cascade)
  responsible  User?        @relation("EventResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, startAt])
  @@map("calendar_events")
}

// =========================================================================
// MOTOR FINANCEIRO CENTRAL (Fase 27) + FASES 8, 9, 10, 11
// =========================================================================

enum FinancialCategoryType {
  RECEITA
  DESPESA
}

model FinancialCategory {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  type           FinancialCategoryType
  parentId       String?
  createdAt      DateTime              @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       FinancialCategory?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children     FinancialCategory[] @relation("CategoryParent")
  movements    FinancialMovement[]
  payables     AccountPayable[]

  @@map("financial_categories")
}

model CostCenter {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements    FinancialMovement[]
  payables     AccountPayable[]

  @@map("cost_centers")
}

enum MovementType {
  RECEITA
  DESPESA
  RECEBIMENTO
  PAGAMENTO
  INVESTIMENTO
  PARCELA
  COMISSAO
  SALARIO
  CUSTO_PROJETO
  AJUSTE
  TRANSFERENCIA
}

enum MovementStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

// Registro central de todo movimento financeiro da empresa (Fase 27).
// AccountReceivable, AccountPayable, CreditCardInstallment e Investment
// geram/vinculam um FinancialMovement para consolidar caixa e previsões.
model FinancialMovement {
  id                 String         @id @default(cuid())
  organizationId     String
  type               MovementType
  amount             Decimal        @db.Decimal(14, 2)
  competenceDate     DateTime
  dueDate            DateTime?
  paidAt             DateTime?
  categoryId         String?
  costCenterId       String?
  clientId           String?
  projectId          String?
  contractId         String?
  paymentMethod      PaymentMethod?
  status             MovementStatus @default(PENDENTE)
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        FinancialCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenter      CostCenter?            @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  client          Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project         Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contract        Contract?              @relation(fields: [contractId], references: [id], onDelete: SetNull)
  receivable      AccountReceivable?
  payable         AccountPayable?
  cardInstallment CreditCardInstallment?
  investment      Investment?

  @@index([organizationId, type, status])
  @@index([organizationId, dueDate])
  @@map("financial_movements")
}

enum ReceivableStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

model AccountReceivable {
  id             String           @id @default(cuid())
  organizationId String
  clientId       String
  contractId     String?
  movementId     String?          @unique
  description    String
  amount         Decimal          @db.Decimal(14, 2)
  dueDate        DateTime
  paymentMethod  PaymentMethod?
  status         ReceivableStatus @default(PENDENTE)
  paidAt         DateTime?
  proofUrl       String?
  notes          String?
  // Link de pagamento enviado ao cliente (/pagar/<token>); gerado no primeiro envio.
  publicToken      String?        @unique
  // Cliente enviou comprovante pela página de pagamento e o financeiro ainda precisa conferir.
  proofSubmittedAt DateTime?
  thanksSentAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contract     Contract?          @relation(fields: [contractId], references: [id], onDelete: SetNull)
  movement     FinancialMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  reminders    PaymentReminder[]

  @@index([organizationId, status, dueDate])
  @@map("accounts_receivable")
}

enum PayableStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

model AccountPayable {
  id                 String        @id @default(cuid())
  organizationId     String
  movementId         String?       @unique
  description        String
  supplier           String?
  categoryId         String?
  costCenterId       String?
  amount             Decimal       @db.Decimal(14, 2)
  dueDate            DateTime
  recurring          Boolean       @default(false)
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?
  responsibleUserId  String?
  teamMemberId       String?
  // Folha: mês de competência ("2026-10") e composição (fixo, comissões, extras). Imposto: kind = IMPOSTO.
  kind               String?
  competence         String?
  breakdown          Json?
  status             PayableStatus @default(PENDENTE)
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenter   CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  movement     FinancialMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  teamMember   TeamMember?        @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueDate])
  @@index([teamMemberId])
  @@index([organizationId, kind, competence])
  @@map("accounts_payable")
}

enum ReminderChannel {
  WHATSAPP
  EMAIL
}

enum ReminderStatus {
  AGENDADO
  ENVIADO
  FALHOU
  CANCELADO
  // A equipe já cobrou o cliente por fora (ligação, WhatsApp pessoal) e marcou como feito.
  MANUAL
}

// LUMI COBRANÇAS — régua de cobrança configurável (Fase 9)
model PaymentReminder {
  id                String          @id @default(cuid())
  receivableId      String
  messageTemplateId String?
  offsetDays        Int
  channel           ReminderChannel
  status            ReminderStatus  @default(AGENDADO)
  scheduledFor      DateTime
  sentAt            DateTime?
  messageBody       String?
  createdAt         DateTime        @default(now())

  receivable      AccountReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  messageTemplate MessageTemplate?  @relation(fields: [messageTemplateId], references: [id], onDelete: SetNull)

  @@map("payment_reminders")
}

enum MessageTrigger {
  D_MENOS_7
  D_MENOS_3
  D_MENOS_1
  D_0
  D_MAIS_1
  D_MAIS_5
}

model MessageTemplate {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  trigger        MessageTrigger
  channel        ReminderChannel
  body           String
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reminders    PaymentReminder[]

  @@map("message_templates")
}

model CreditCard {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  institution    String?
  limitAmount    Decimal? @db.Decimal(14, 2)
  closingDay     Int
  dueDay         Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions CreditCardTransaction[]

  @@map("credit_cards")
}

model CreditCardTransaction {
  id                String   @id @default(cuid())
  cardId            String
  description       String
  category          String?
  totalAmount       Decimal  @db.Decimal(14, 2)
  purchaseDate      DateTime
  installmentsTotal Int      @default(1)
  createdAt         DateTime @default(now())

  card         CreditCard              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  installments CreditCardInstallment[]

  @@map("credit_card_transactions")
}

model CreditCardInstallment {
  id            String   @id @default(cuid())
  transactionId String
  movementId    String?  @unique
  number        Int
  amount        Decimal  @db.Decimal(14, 2)
  invoiceMonth  DateTime
  paid          Boolean  @default(false)

  transaction CreditCardTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  movement    FinancialMovement?    @relation(fields: [movementId], references: [id], onDelete: SetNull)

  @@map("credit_card_installments")
}

model Investment {
  id             String         @id @default(cuid())
  organizationId String
  movementId     String?        @unique
  description    String
  category       String
  amount         Decimal        @db.Decimal(14, 2)
  date           DateTime
  paymentMethod  PaymentMethod?
  installments   Int            @default(1)
  objective      String?
  expectedReturn String?
  notes          String?
  createdAt      DateTime       @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movement     FinancialMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)

  @@map("investments")
}

// =========================================================================
// METAS (Fase 13)
// =========================================================================

enum GoalType {
  FATURAMENTO
  NOVOS_CLIENTES
  PROSPECCAO
  PROJETOS
  MARGEM
  RECEBIMENTOS
}

enum GoalScenario {
  CONSERVADOR
  REALISTA
  AGRESSIVO
}

model Goal {
  id             String       @id @default(cuid())
  organizationId String
  type           GoalType
  scenario       GoalScenario @default(REALISTA)
  periodStart    DateTime
  periodEnd      DateTime
  targetValue    Decimal      @db.Decimal(14, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, periodStart, periodEnd, scenario])
  @@map("goals")
}

// =========================================================================
// ALERTAS E NOTIFICAÇÕES (Fase 17)
// =========================================================================

enum AlertCategory {
  FINANCEIRO
  COMERCIAL
  OPERACAO
  CLIENTES
  CONTRATOS
  EQUIPE
  MIDIA_ADESF
}

enum AlertSeverity {
  URGENTE
  ATENCAO
  INFORMATIVO
  OPORTUNIDADE
}

enum AlertStatus {
  ABERTO
  RESOLVIDO
  DISPENSADO
}

model Alert {
  id                String        @id @default(cuid())
  organizationId    String
  category          AlertCategory
  severity          AlertSeverity
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  status            AlertStatus   @default(ABERTO)
  createdAt         DateTime      @default(now())
  resolvedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("alerts")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String
  link           String?
  // tarefas | comercial | financeiro | alertas | operacao | midia | resumo
  category       String?
  // Lembretes automáticos (rotina de pendências) não se repetem: uma chave por aviso.
  dedupeKey      String?   @unique
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// Um aparelho (navegador/app instalado) que aceitou receber notificações push.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Configurações do servidor que não pertencem a uma organização (ex: chaves VAPID do push).
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// =========================================================================
// DOCUMENTOS (Fase 15)
// =========================================================================

enum DocumentCategory {
  CONTRATO
  PROPOSTA
  BRIEFING
  COMPROVANTE
  NOTA_FISCAL
  DOCUMENTO_CLIENTE
  DOCUMENTO_EQUIPE
  OUTRO
}

model Document {
  id               String           @id @default(cuid())
  organizationId   String
  name             String
  category         DocumentCategory
  clientId         String?
  projectId        String?
  storageProvider  String           @default("local")
  storageKey       String
  mimeType         String
  size             Int
  uploadedByUserId String?
  createdAt        DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploadedBy   User?        @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@map("documents")
}

// =========================================================================
// INTEGRAÇÕES E LUMIHUB VAULT (Fase 14, 32, 33, 34)
// =========================================================================

enum IntegrationCategory {
  CALENDARIO
  COMUNICACAO
  FINANCEIRO
  IA
  ARMAZENAMENTO
  AUTOMACAO
  OUTROS
}

enum IntegrationProviderKey {
  GOOGLE_CALENDAR
  OUTLOOK_CALENDAR
  WHATSAPP_BUSINESS
  EMAIL_SMTP
  RESEND
  PIX
  ASAAS
  STRIPE
  MERCADO_PAGO
  OPENAI
  ANTHROPIC
  GOOGLE_GEMINI
  GOOGLE_DRIVE
  DROPBOX
  N8N
  MAKE
  ZAPIER
  WEBHOOK_CUSTOM
  CUSTOM_API
  YOUTUBE_DATA_API
  AUTENTIQUE
}

enum IntegrationStatus {
  CONECTADO
  PENDENTE
  ERRO
  EXPIRADO
  DESCONECTADO
}

model Integration {
  id                String                 @id @default(cuid())
  organizationId    String
  provider          IntegrationProviderKey
  category          IntegrationCategory
  status            IntegrationStatus      @default(DESCONECTADO)
  config            Json?
  connectedAt       DateTime?
  lastSyncAt        DateTime?
  lastUsedAt        DateTime?
  connectedByUserId String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User?                   @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
  credentials  IntegrationCredential[]
  webhooks     IntegrationWebhook[]
  logs         IntegrationLog[]

  @@unique([organizationId, provider])
  @@map("integrations")
}

// LUMIHUB VAULT — segredos sempre criptografados (AES-256-GCM), nunca em texto puro.
model IntegrationCredential {
  id             String    @id @default(cuid())
  integrationId  String
  label          String
  encryptedValue Bytes
  iv             Bytes
  authTag        Bytes
  maskedPreview  String
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  rotatedAt      DateTime?
  createdAt      DateTime  @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("integration_credentials")
}

model IntegrationWebhook {
  id             String   @id @default(cuid())
  organizationId String
  integrationId  String?
  name           String
  slug           String   @unique
  secretHash     String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration?     @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  logs         IntegrationLog[]

  @@map("integration_webhooks")
}

enum LogDirection {
  ENTRADA
  SAIDA
}

enum LogStatus {
  SUCESSO
  FALHA
  PENDENTE
}

model IntegrationLog {
  id             String       @id @default(cuid())
  organizationId String
  integrationId  String?
  webhookId      String?
  direction      LogDirection
  eventType      String
  payload        Json?
  status         LogStatus
  responseCode   Int?
  attempt        Int          @default(1)
  errorMessage   String?
  createdAt      DateTime     @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration?        @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  webhook      IntegrationWebhook? @relation(fields: [webhookId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("integration_logs")
}

// =========================================================================
// LUMI AI (Fase 16, 30, 31)
// =========================================================================

model AiConversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AiMessage[]

  @@map("ai_conversations")
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AiMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

model AiInsight {
  id                String        @id @default(cuid())
  organizationId    String
  type              String
  title             String
  description       String
  severity          AlertSeverity
  relatedEntityType String?
  relatedEntityId   String?
  generatedAt       DateTime      @default(now())
  dismissedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ai_insights")
}

// =========================================================================
// MÍDIA ADESF (Fase 01) — módulo dentro da mesma organização/autenticação
// da LUMIBASE. Um usuário existente ganha acesso à Mídia ADESF via
// MediaMember (união de permissões em @/lib/auth/session), sem precisar
// trocar o Role principal dele — evita o anti-padrão de um único
// "is_media_member = true" e permite múltiplos contextos no futuro.
// =========================================================================

enum MediaMemberRole {
  LIDER
  MEMBRO
}

enum MediaMemberStatus {
  INVITED
  ACTIVE
  INACTIVE
  SUSPENDED
}

model MediaMember {
  id                  String            @id @default(cuid())
  organizationId      String
  userId              String            @unique
  role                MediaMemberRole   @default(MEMBRO)
  status              MediaMemberStatus @default(INVITED)
  phone               String?
  administrativeNotes String?
  invitedByUserId     String?
  joinedAt            DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  organization           Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  functions              MediaMemberFunction[]
  availabilityRecurring  MediaAvailabilityRecurring[]
  availabilityExceptions MediaAvailabilityException[]
  scheduleAssignments    MediaScheduleAssignment[]    @relation("MediaMemberAssignments")
  swapRequestsSent       MediaSwapRequest[]           @relation("MediaSwapRequestedBy")
  swapRequestsReceived   MediaSwapRequest[]           @relation("MediaSwapTarget")
  attendances            MediaAttendance[]            @relation("MediaMemberAttendance")
  aiSuggestionsAsTarget  MediaAISuggestion[]          @relation("MediaAISuggestedMember")
  actionTokens           MediaActionToken[]
  mentoringFunctions     MediaMemberFunction[]        @relation("MediaMemberFunctionMentor")

  @@index([organizationId, status])
  @@map("media_members")
}

model MediaFunction {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization           Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberFunctions        MediaMemberFunction[]
  eventRequirements      MediaEventRequirement[]
  defaultRequirements    MediaEventDefaultRequirement[]
  recurrenceRequirements MediaEventRecurrenceRequirement[]
  scheduleAssignments    MediaScheduleAssignment[]
  aiSuggestions          MediaAISuggestion[]

  @@unique([organizationId, name])
  @@map("media_functions")
}

enum MediaFunctionAssignmentStatus {
  EM_TREINAMENTO
  HABILITADO
  AVANCADO
}

model MediaMemberFunction {
  id             String                        @id @default(cuid())
  memberId       String
  functionId     String
  isPrimary      Boolean                       @default(false)
  status         MediaFunctionAssignmentStatus @default(HABILITADO)
  // Titular responsável por acompanhar quem está EM_TREINAMENTO nesta
  // função (§ pedido do usuário) — só informativo por enquanto: aparece no
  // perfil do membro e como dica na hora de escalar, não altera sozinho
  // nenhuma escala.
  mentorMemberId String?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  member   MediaMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  function MediaFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  mentor   MediaMember?  @relation("MediaMemberFunctionMentor", fields: [mentorMemberId], references: [id], onDelete: SetNull)

  @@unique([memberId, functionId])
  @@map("media_member_functions")
}

// Disponibilidade recorrente semanal — alimenta a futura IA de escala.
model MediaAvailabilityRecurring {
  id        String   @id @default(cuid())
  memberId  String
  dayOfWeek Int // 0 = domingo ... 6 = sábado
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member MediaMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("media_availability_recurring")
}

// Exceções pontuais (uma data específica), sem afetar a recorrência.
model MediaAvailabilityException {
  id        String   @id @default(cuid())
  memberId  String
  date      DateTime @db.Date
  startTime String
  endTime   String
  available Boolean  @default(true)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member MediaMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, date])
  @@map("media_availability_exceptions")
}

// Link de um clique enviado por WhatsApp perguntando disponibilidade para um
// culto específico — nunca exige login (o token É a autorização, mesmo
// modelo de confiança do PasswordResetToken). Guarda só o hash do token,
// nunca o valor puro; expira e é de uso único (usedAt) para não permitir
// reabrir e trocar a resposta depois de já respondido.
// AVAILABILITY_REQUEST: pergunta de disponibilidade pontual (eventId),
// antes de existir escala — uso único, grava MediaAvailabilityException.
// SCHEDULE_CONFIRMATION: disparo único por escala publicada (scheduleId)
// — nunca expira no primeiro clique, porque a mesma página lista TODOS os
// cultos do membro naquele mês e cada um é respondido de forma
// independente; só expira pelo prazo (fim do período + folga).
// SWAP_ACCEPT: convite de um clique pro substituto sugerido pela IA
// aceitar/recusar uma troca (swapRequestId) — uso único.
enum MediaActionTokenType {
  AVAILABILITY_REQUEST
  SCHEDULE_CONFIRMATION
  SWAP_ACCEPT
}

model MediaActionToken {
  id             String               @id @default(cuid())
  organizationId String
  memberId       String
  type           MediaActionTokenType @default(AVAILABILITY_REQUEST)
  eventId        String?
  scheduleId     String?
  swapRequestId  String?
  tokenHash      String               @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime             @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       MediaMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event        MediaEvent?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  schedule     MediaSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  swapRequest  MediaSwapRequest? @relation(fields: [swapRequestId], references: [id], onDelete: Cascade)

  @@index([organizationId, memberId])
  @@index([scheduleId, memberId])
  @@map("media_action_tokens")
}

model MediaBrandSettings {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  environmentName String   @default("MÍDIA ADESF")
  logoUrl         String?
  logoLightUrl    String?
  logoDarkUrl     String?
  faviconUrl      String?
  primaryColor    String   @default("#16A34A")
  secondaryColor  String   @default("#0F766E")
  gradientStart   String   @default("#16A34A")
  gradientEnd     String   @default("#22D3A8")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("media_brand_settings")
}

// Link público de "quem está escalado" (§ pedido do usuário: compartilhar
// com o gestor/obreiros sem exigir login) — um único link por organização,
// guardado em texto puro (diferente de MediaActionToken) porque precisa ser
// reexibido e copiado pelo admin sempre que ele visita Configurações; não é
// um segredo de uso único, é um "link com capacidade" como o de um Google
// Doc compartilhado. "Regenerar" sobrescreve o token: o link anterior para
// de funcionar na hora, sem precisar revogar nada à parte.
model MediaPublicScheduleLink {
  id             String   @id @default(cuid())
  organizationId String   @unique
  token          String   @unique
  createdAt      DateTime @default(now())
  rotatedAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("media_public_schedule_links")
}

enum MediaInvitationStatus {
  INVITED
  ACCEPTED
  EXPIRED
  CANCELLED
}

model MediaInvitation {
  id              String                @id @default(cuid())
  organizationId  String
  email           String
  role            MediaMemberRole       @default(MEMBRO)
  invitedByUserId String
  status          MediaInvitationStatus @default(INVITED)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("MediaInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("media_invitations")
}

// =========================================================================
// MÍDIA ADESF (Fase 02) — motor operacional: cultos/eventos, escalas,
// atribuições, trocas e presença. Modelo relacional (EVENTO -> FUNÇÕES
// NECESSÁRIAS -> ATRIBUIÇÕES -> MEMBROS), nunca uma planilha fixa por dia.
// Reaproveita CalendarEvent (campo mediaEventId acima) em vez de duplicar
// um calendário próprio, e Notification (já existente) para os avisos
// internos — nenhum canal (e-mail/WhatsApp) é acoplado aqui.
// =========================================================================

enum MediaEventStatus {
  DRAFT
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  ARCHIVED
}

// Só suporta recorrência semanal nesta fase (cobre os exemplos da
// especificação — "todo domingo às 19h"). Estrutura já preparada para
// ganhar outras frequências sem migração destrutiva.
enum MediaRecurrenceFrequency {
  WEEKLY
}

model MediaEventRecurrence {
  id             String                   @id @default(cuid())
  organizationId String
  name           String
  frequency      MediaRecurrenceFrequency @default(WEEKLY)
  dayOfWeek      Int // 0 = domingo ... 6 = sábado
  startTime      String // "HH:mm"
  endTime        String? // "HH:mm"
  location       String?
  type           String                   @default("Culto")
  startDate      DateTime                 @db.Date
  endDate        DateTime?                @db.Date
  active         Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       MediaEvent[]
  requirements MediaEventRecurrenceRequirement[]

  @@index([organizationId, active])
  @@map("media_event_recurrences")
}

// "Template de série" (funções necessárias de UMA série recorrente
// específica, ex: "Culto de Domingo" sempre precisa de Data Show + 2
// Câmeras). Escopo por recurrenceId, nunca por organizationId como
// MediaEventDefaultRequirement (o padrão genérico da organização inteira)
// — cada série recorrente pode exigir um conjunto de funções diferente.
// Aplicado a toda ocorrência nova gerada pela série (ver
// applyDefaultRequirementsToEvent) e reaplicado às ocorrências futuras já
// existentes quando o líder edita uma delas e escolhe propagar (§ pedido
// do usuário: "editar as funções de 01 também altera todo o resto").
model MediaEventRecurrenceRequirement {
  id               String   @id @default(cuid())
  recurrenceId     String
  functionId       String
  requiredQuantity Int      @default(1)
  mandatory        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recurrence MediaEventRecurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  function   MediaFunction        @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@unique([recurrenceId, functionId])
  @@map("media_event_recurrence_requirements")
}

model MediaEvent {
  id                  String           @id @default(cuid())
  organizationId      String
  name                String
  type                String           @default("Culto")
  startAt             DateTime
  endAt               DateTime?
  location            String?
  description         String?
  administrativeNotes String?
  status              MediaEventStatus @default(SCHEDULED)
  recurrenceId        String?
  createdByUserId     String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recurrence    MediaEventRecurrence?     @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  createdBy     User?                     @relation("MediaEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  requirements  MediaEventRequirement[]
  assignments   MediaScheduleAssignment[]
  calendarEvent CalendarEvent?
  aiSuggestions MediaAISuggestion[]
  actionTokens  MediaActionToken[]

  @@index([organizationId, startAt])
  @@index([recurrenceId])
  @@map("media_events")
}

model MediaEventRequirement {
  id               String   @id @default(cuid())
  eventId          String
  functionId       String
  requiredQuantity Int      @default(1)
  mandatory        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event    MediaEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  function MediaFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@unique([eventId, functionId])
  @@map("media_event_requirements")
}

// Configuração padrão ("Template de Culto", §88) aplicada automaticamente
// a todo evento novo — o líder edita esta lista uma vez em Configurações
// em vez de reconfigurar função por função a cada culto criado.
model MediaEventDefaultRequirement {
  id               String   @id @default(cuid())
  organizationId   String
  functionId       String
  requiredQuantity Int      @default(1)
  mandatory        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  function     MediaFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, functionId])
  @@map("media_event_default_requirements")
}

enum MediaScheduleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

model MediaSchedule {
  id                String              @id @default(cuid())
  organizationId    String
  name              String
  month             Int
  year              Int
  periodStart       DateTime            @db.Date
  periodEnd         DateTime            @db.Date
  status            MediaScheduleStatus @default(DRAFT)
  createdByUserId   String?
  publishedByUserId String?
  publishedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User?                     @relation("MediaScheduleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedBy      User?                     @relation("MediaSchedulePublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  assignments      MediaScheduleAssignment[]
  aiGenerationRuns MediaAIGenerationRun[]
  actionTokens     MediaActionToken[]

  @@unique([organizationId, month, year])
  @@map("media_schedules")
}

enum MediaAssignmentStatus {
  UNASSIGNED
  ASSIGNED
  CONFIRMED
  SWAP_PENDING
  COMPLETED
  ABSENT
}

model MediaScheduleAssignment {
  id               String                @id @default(cuid())
  scheduleId       String
  eventId          String
  functionId       String
  slotIndex        Int                   @default(0)
  memberId         String?
  status           MediaAssignmentStatus @default(UNASSIGNED)
  assignedByUserId String?
  assignedAt       DateTime?
  aiGenerated      Boolean               @default(false)
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  schedule      MediaSchedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  event         MediaEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  function      MediaFunction       @relation(fields: [functionId], references: [id], onDelete: Cascade)
  member        MediaMember?        @relation("MediaMemberAssignments", fields: [memberId], references: [id], onDelete: SetNull)
  assignedBy    User?               @relation("MediaAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  swapRequests  MediaSwapRequest[]
  attendance    MediaAttendance?
  aiSuggestions MediaAISuggestion[]

  @@unique([scheduleId, eventId, functionId, slotIndex])
  @@index([memberId])
  @@index([eventId])
  @@index([status])
  @@map("media_schedule_assignments")
}

enum MediaSwapStatus {
  PENDING_TARGET
  TARGET_ACCEPTED
  TARGET_REJECTED
  PENDING_LEADER
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

model MediaSwapRequest {
  id                  String          @id @default(cuid())
  organizationId      String
  assignmentId        String
  requestedByMemberId String
  targetMemberId      String
  reason              String?
  status              MediaSwapStatus @default(PENDING_TARGET)
  // Só trocas geradas pela sugestão automática da IA (declínio via link de
  // confirmação mensal) escalam sozinhas para o próximo candidato — uma
  // troca pedida por um MEMBRO para um colega específico nunca deve ser
  // redirecionada para outra pessoa sem o pedido original ser cancelado.
  autoSuggested       Boolean         @default(false)
  requestedAt         DateTime        @default(now())
  targetRespondedAt   DateTime?
  leaderRespondedAt   DateTime?
  leaderUserId        String?
  decisionNotes       String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignment   MediaScheduleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  requestedBy  MediaMember             @relation("MediaSwapRequestedBy", fields: [requestedByMemberId], references: [id], onDelete: Cascade)
  targetMember MediaMember             @relation("MediaSwapTarget", fields: [targetMemberId], references: [id], onDelete: Cascade)
  leader       User?                   @relation("MediaSwapLeader", fields: [leaderUserId], references: [id], onDelete: SetNull)
  actionTokens MediaActionToken[]

  @@index([assignmentId])
  @@index([organizationId, status])
  @@index([targetMemberId])
  @@index([requestedByMemberId])
  @@index([status, autoSuggested, requestedAt])
  @@map("media_swap_requests")
}

enum MediaConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
  EXPIRED
}

enum MediaCheckinStatus {
  PENDING
  CHECKED_IN
  NO_SHOW
}

model MediaAttendance {
  id                 String                  @id @default(cuid())
  assignmentId       String                  @unique
  memberId           String
  confirmationStatus MediaConfirmationStatus @default(PENDING)
  confirmedAt        DateTime?
  checkinStatus      MediaCheckinStatus      @default(PENDING)
  checkedInAt        DateTime?
  markedByUserId     String?
  notes              String?
  googleEventId      String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  assignment MediaScheduleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  member     MediaMember             @relation("MediaMemberAttendance", fields: [memberId], references: [id], onDelete: Cascade)
  markedBy   User?                   @relation("MediaAttendanceMarkedBy", fields: [markedByUserId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@map("media_attendances")
}

// Prazos de confirmação/lembrete (§43) — nunca hardcoded.
model MediaOperationsSettings {
  id                    String   @id @default(cuid())
  organizationId        String   @unique
  confirmationLeadHours Int      @default(72)
  reminderLeadHours     Int      @default(24)
  leaderAlertLeadHours  Int      @default(48)
  // Pesos da IA de escala (§8) — disponibilidade/habilitação/conflito são
  // sempre obrigatórios (nunca configuráveis); só os critérios
  // preferenciais têm peso ajustável pelo líder.
  aiWeightWorkload      Int      @default(100)
  aiWeightRecency       Int      @default(50)
  aiWeightPreference    Int      @default(20)
  // Intervalo mínimo de descanso, em dias, que a geração por IA tenta
  // respeitar antes de escalar o MESMO membro de novo — "bom senso" de
  // intercalar quem serve, não uma restrição obrigatória: só é ignorado
  // quando não sobra nenhum outro candidato elegível para a vaga.
  aiMinRestDays         Int      @default(6)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("media_operations_settings")
}

model MediaAIGenerationRun {
  id                String    @id @default(cuid())
  organizationId    String
  scheduleId        String
  requestedByUserId String
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  suggestionsCount  Int       @default(0)
  filledCount       Int       @default(0)
  weightsSnapshot   Json
  createdAt         DateTime  @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule     MediaSchedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  requestedBy  User                @relation("MediaAIGenerationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  suggestions  MediaAISuggestion[]

  @@index([organizationId, scheduleId])
  @@map("media_ai_generation_runs")
}

// Registro imutável do que a IA propôs num momento — permanece mesmo que o
// líder altere a atribuição depois, para permitir comparar "sugerido vs
// publicado" (§14) sem depender do estado atual (mutável) da atribuição.
model MediaAISuggestion {
  id                String   @id @default(cuid())
  runId             String
  eventId           String
  functionId        String
  slotIndex         Int
  assignmentId      String?
  suggestedMemberId String?
  score             Float?
  justification     String
  createdAt         DateTime @default(now())

  run             MediaAIGenerationRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  event           MediaEvent               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  function        MediaFunction            @relation(fields: [functionId], references: [id], onDelete: Cascade)
  assignment      MediaScheduleAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  suggestedMember MediaMember?             @relation("MediaAISuggestedMember", fields: [suggestedMemberId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@map("media_ai_suggestions")
}
