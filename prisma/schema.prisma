// LUMIHUB — Schema de banco de dados
// Sistema operacional interno da Lumière Agency

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// ORGANIZAÇÃO / MULTI-EMPRESA (Fase 45)
// Toda entidade pertence a uma Organization, permitindo múltiplas empresas
// isoladas na mesma implantação. User.email é único globalmente (não por
// organização) porque o login resolve a conta apenas pelo e-mail, sem pedir
// qual organização — cada pessoa pertence a exatamente uma organização.
// =========================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/Sao_Paulo")
  currency  String   @default("BRL")
  locale    String   @default("pt-BR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                         User[]
  roles                         Role[]
  auditLogs                     AuditLog[]
  leads                         Lead[]
  clients                       Client[]
  contractTemplates             ContractTemplate[]
  contracts                     Contract[]
  proposals                     Proposal[]
  projects                      Project[]
  tasks                         Task[]
  teamMembers                   TeamMember[]
  services                      Service[]
  captures                      Capture[]
  calendarEvents                CalendarEvent[]
  financialCategories           FinancialCategory[]
  costCenters                   CostCenter[]
  financialMovements            FinancialMovement[]
  accountsReceivable            AccountReceivable[]
  accountsPayable               AccountPayable[]
  messageTemplates              MessageTemplate[]
  creditCards                   CreditCard[]
  investments                   Investment[]
  goals                         Goal[]
  alerts                        Alert[]
  notifications                 Notification[]
  documents                     Document[]
  integrations                  Integration[]
  integrationWebhooks           IntegrationWebhook[]
  integrationLogs               IntegrationLog[]
  aiConversations               AiConversation[]
  aiInsights                    AiInsight[]
  captureAssignments            CaptureAssignment[]
  mediaMembers                  MediaMember[]
  mediaFunctions                MediaFunction[]
  mediaInvitations              MediaInvitation[]
  mediaBrandSettings            MediaBrandSettings?
  mediaEvents                   MediaEvent[]
  mediaEventRecurrences         MediaEventRecurrence[]
  mediaEventDefaultRequirements MediaEventDefaultRequirement[]
  mediaSchedules                MediaSchedule[]
  mediaSwapRequests             MediaSwapRequest[]
  mediaOperationsSettings       MediaOperationsSettings?
  mediaAIGenerationRuns         MediaAIGenerationRun[]
  mediaActionTokens             MediaActionToken[]

  @@map("organizations")
}

// =========================================================================
// AUTENTICAÇÃO, RBAC E SEGURANÇA (Fase 1)
// =========================================================================

enum RoleKey {
  ADMIN
  FINANCEIRO
  OPERACAO
  COMERCIAL
  GESTAO
  CUSTOM
  // Role "casca vazia" exclusiva do shell user do Mídia ADESF (ver
  // ensureMediaOnlyRole em @/lib/media/bootstrap.ts). Nunca usar CUSTOM
  // aqui: CUSTOM é o slot único de "perfil personalizado" que o próprio
  // admin cria em Usuários e Permissões (@@unique([organizationId, key])),
  // e reaproveitá-lo para este shell colidia (P2002) sempre que a
  // organização já tinha um perfil personalizado seu.
  MEDIA_ONLY
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  key            RoleKey
  name           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]

  @@unique([organizationId, key])
  @@map("roles")
}

// Chaves granulares: <MODULE>_<ACTION>, ex: FINANCE_VIEW, FINANCE_CREATE, MANAGE_INTEGRATIONS
model Permission {
  id          String @id @default(cuid())
  key         String @unique
  module      String
  action      String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id              String    @id @default(cuid())
  organizationId  String
  roleId          String
  name            String
  email           String    @unique
  passwordHash    String
  avatarUrl       String?
  isActive        Boolean   @default(true)
  isOwner         Boolean   @default(false)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization              Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                      Role                      @relation(fields: [roleId], references: [id])
  sessions                  Session[]
  passwordResets            PasswordResetToken[]
  auditLogs                 AuditLog[]
  ownedLeads                Lead[]                    @relation("LeadOwner")
  responsibleProjects       Project[]                 @relation("ProjectResponsible")
  assignedTasks             Task[]                    @relation("TaskAssignee")
  teamMemberProfile         TeamMember?
  calendarEvents            CalendarEvent[]           @relation("EventResponsible")
  notifications             Notification[]
  documentsUploaded         Document[]
  aiConversations           AiConversation[]
  connectedIntegrations     Integration[]
  captureAssignments        CaptureAssignment[]
  mediaMember               MediaMember?
  mediaInvitationsSent      MediaInvitation[]         @relation("MediaInvitationInviter")
  mediaEventsCreated        MediaEvent[]              @relation("MediaEventCreatedBy")
  mediaSchedulesCreated     MediaSchedule[]           @relation("MediaScheduleCreatedBy")
  mediaSchedulesPublished   MediaSchedule[]           @relation("MediaSchedulePublishedBy")
  mediaAssignmentsAssigned  MediaScheduleAssignment[] @relation("MediaAssignmentAssignedBy")
  mediaSwapRequestsAsLeader MediaSwapRequest[]        @relation("MediaSwapLeader")
  mediaAttendanceMarked     MediaAttendance[]         @relation("MediaAttendanceMarkedBy")
  mediaAIGenerationRuns     MediaAIGenerationRun[]    @relation("MediaAIGenerationRequestedBy")

  @@index([organizationId])
  @@map("users")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Rastreia tentativas de login por e-mail e IP para rate limiting / brute force
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =========================================================================
// COMERCIAL — CRM E PROSPECÇÃO (Fase 4)
// =========================================================================

enum LeadStage {
  LEAD
  CONTATO
  QUALIFICADO
  REUNIAO
  PROPOSTA
  NEGOCIACAO
  FECHADO
  PERDIDO
}

model Lead {
  id                String    @id @default(cuid())
  organizationId    String
  company           String
  contactName       String?
  phone             String?
  whatsapp          String?
  instagram         String?
  website           String?
  city              String?
  segment           String?
  source            String?
  ownerUserId       String?
  potentialValue    Decimal?  @db.Decimal(14, 2)
  probability       Int       @default(0)
  stage             LeadStage @default(LEAD)
  lastContactAt     DateTime?
  nextContactAt     DateTime?
  notes             String?
  convertedClientId String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           User?        @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  convertedClient Client?      @relation(fields: [convertedClientId], references: [id])
  proposals       Proposal[]

  @@index([organizationId, stage])
  @@map("leads")
}

enum ProposalStatus {
  RASCUNHO
  ENVIADA
  EM_NEGOCIACAO
  ACEITA
  RECUSADA
  EXPIRADA
}

model Proposal {
  id             String         @id @default(cuid())
  organizationId String
  leadId         String?
  clientId       String?
  title          String
  value          Decimal        @db.Decimal(14, 2)
  status         ProposalStatus @default(RASCUNHO)
  validUntil     DateTime?
  sentAt         DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("proposals")
}

// =========================================================================
// CLIENTES E CONTRATOS (Fase 5)
// =========================================================================

enum ClientStatus {
  ATIVO
  INATIVO
  PROSPECTO
  INADIMPLENTE
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  companyName    String
  cnpj           String?
  contactName    String?
  email          String?
  phone          String?
  address        String?
  instagram      String?
  website        String?
  status         ClientStatus @default(ATIVO)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  originLead         Lead?
  contracts          Contract[]
  proposals          Proposal[]
  projects           Project[]
  captures           Capture[]
  calendarEvents     CalendarEvent[]
  accountsReceivable AccountReceivable[]
  financialMovements FinancialMovement[]
  documents          Document[]

  @@index([organizationId, status])
  @@map("clients")
}

enum ContractType {
  CLIENTE
  FUNCIONARIO
  FREELANCER
  PRESTADOR
  UGC
  AUDIOVISUAL
  SOCIAL_MEDIA
  TRAFEGO
  DESIGN
  DESENVOLVIMENTO
  PERSONALIZADO
}

model ContractTemplate {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  type           ContractType
  bodyTemplate   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contracts    Contract[]

  @@map("contract_templates")
}

enum ContractStatus {
  RASCUNHO
  AGUARDANDO_ASSINATURA
  ATIVO
  ENCERRADO
  CANCELADO
}

enum RecurrenceType {
  UNICO
  MENSAL
  TRIMESTRAL
  ANUAL
}

model Contract {
  id             String         @id @default(cuid())
  organizationId String
  clientId       String
  templateId     String?
  title          String
  type           ContractType
  value          Decimal        @db.Decimal(14, 2)
  recurrence     RecurrenceType @default(UNICO)
  startDate      DateTime
  endDate        DateTime?
  paymentDay     Int?
  status         ContractStatus @default(RASCUNHO)
  fileUrl        String?
  generatedBody  String?
  signedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template           ContractTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  projects           Project[]
  accountsReceivable AccountReceivable[]
  financialMovements FinancialMovement[]
  calendarEvents     CalendarEvent[]

  @@index([organizationId, status])
  @@map("contracts")
}

// =========================================================================
// PROJETOS, TAREFAS, EQUIPE E CAPTAÇÕES (Fase 6)
// =========================================================================

enum ProjectStatus {
  BACKLOG
  PLANEJAMENTO
  EM_PRODUCAO
  EM_REVISAO
  AGUARDANDO_CLIENTE
  CONCLUIDO
  ATRASADO
}

model Project {
  id                String        @id @default(cuid())
  organizationId    String
  clientId          String
  contractId        String?
  name              String
  responsibleUserId String?
  status            ProjectStatus @default(BACKLOG)
  startDate         DateTime?
  dueDate           DateTime?
  value             Decimal?      @db.Decimal(14, 2)
  costEstimate      Decimal?      @db.Decimal(14, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contract           Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  responsible        User?               @relation("ProjectResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  tasks              Task[]
  team               ProjectTeamMember[]
  captures           Capture[]
  calendarEvents     CalendarEvent[]
  documents          Document[]
  financialMovements FinancialMovement[]

  @@index([organizationId, status])
  @@map("projects")
}

enum TaskStatus {
  A_FAZER
  EM_ANDAMENTO
  EM_REVISAO
  CONCLUIDA
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  title          String
  description    String?
  assigneeUserId String?
  status         TaskStatus   @default(A_FAZER)
  priority       TaskPriority @default(MEDIA)
  dueDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("tasks")
}

enum TeamMemberType {
  FUNCIONARIO
  FREELANCER
  PRESTADOR
}

enum PaymentMethod {
  PIX
  TRANSFERENCIA
  BOLETO
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
  OUTRO
}

model TeamMember {
  id             String         @id @default(cuid())
  organizationId String
  userId         String?        @unique
  name           String
  role           String
  type           TeamMemberType
  paymentValue   Decimal?       @db.Decimal(14, 2)
  paymentMethod  PaymentMethod?
  paymentDay     Int?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  projects     ProjectTeamMember[]
  payables     AccountPayable[]

  @@map("team_members")
}

model ProjectTeamMember {
  projectId     String
  teamMemberId  String
  roleInProject String?
  costAllocated Decimal? @db.Decimal(14, 2)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@id([projectId, teamMemberId])
  @@map("project_team_members")
}

model Service {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  category       String?
  defaultPrice   Decimal? @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("services")
}

enum CaptureStatus {
  PLANEJADA
  CONFIRMADA
  REALIZADA
  EM_EDICAO
  ENTREGUE
}

model Capture {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  projectId      String?
  date           DateTime
  location       String?
  status         CaptureStatus @default(PLANEJADA)
  videomaker     String?
  photographer   String?
  storymaker     String?
  droneOperator  String?
  videoCount     Int?
  photoCount     Int?
  scriptNotes    String?
  equipment      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  calendarEvents CalendarEvent[]
  assignments    CaptureAssignment[]

  @@index([organizationId, status])
  @@map("captures")
}

// Aceite de escala (Fase 46): cada membro de equipe atribuído a uma
// captação recebe uma notificação e precisa aceitar ou recusar — o aceite
// confirma a presença dele na Agenda, sem precisar de app nativo/push.
enum CaptureAssignmentStatus {
  PENDENTE
  ACEITO
  RECUSADO
}

model CaptureAssignment {
  id             String                  @id @default(cuid())
  organizationId String
  captureId      String
  userId         String
  role           String
  status         CaptureAssignmentStatus @default(PENDENTE)
  respondedAt    DateTime?
  createdAt      DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capture      Capture      @relation(fields: [captureId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([captureId, userId, role])
  @@index([userId, status])
  @@map("capture_assignments")
}

// =========================================================================
// CALENDÁRIO (Fase 7)
// =========================================================================

enum CalendarEventType {
  CAPTACAO
  REUNIAO
  ENTREGA
  VENCIMENTO
  COBRANCA
  CONTRATO
  TAREFA
  INTERNO
  MIDIA
}

model CalendarEvent {
  id                String            @id @default(cuid())
  organizationId    String
  title             String
  type              CalendarEventType
  startAt           DateTime
  endAt             DateTime?
  allDay            Boolean           @default(false)
  clientId          String?
  projectId         String?
  captureId         String?
  contractId        String?
  mediaEventId      String?           @unique
  responsibleUserId String?
  location          String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  capture      Capture?     @relation(fields: [captureId], references: [id], onDelete: Cascade)
  contract     Contract?    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  mediaEvent   MediaEvent?  @relation(fields: [mediaEventId], references: [id], onDelete: Cascade)
  responsible  User?        @relation("EventResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, startAt])
  @@map("calendar_events")
}

// =========================================================================
// MOTOR FINANCEIRO CENTRAL (Fase 27) + FASES 8, 9, 10, 11
// =========================================================================

enum FinancialCategoryType {
  RECEITA
  DESPESA
}

model FinancialCategory {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  type           FinancialCategoryType
  parentId       String?
  createdAt      DateTime              @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       FinancialCategory?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children     FinancialCategory[] @relation("CategoryParent")
  movements    FinancialMovement[]
  payables     AccountPayable[]

  @@map("financial_categories")
}

model CostCenter {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements    FinancialMovement[]
  payables     AccountPayable[]

  @@map("cost_centers")
}

enum MovementType {
  RECEITA
  DESPESA
  RECEBIMENTO
  PAGAMENTO
  INVESTIMENTO
  PARCELA
  COMISSAO
  SALARIO
  CUSTO_PROJETO
  AJUSTE
  TRANSFERENCIA
}

enum MovementStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

// Registro central de todo movimento financeiro da empresa (Fase 27).
// AccountReceivable, AccountPayable, CreditCardInstallment e Investment
// geram/vinculam um FinancialMovement para consolidar caixa e previsões.
model FinancialMovement {
  id                 String         @id @default(cuid())
  organizationId     String
  type               MovementType
  amount             Decimal        @db.Decimal(14, 2)
  competenceDate     DateTime
  dueDate            DateTime?
  paidAt             DateTime?
  categoryId         String?
  costCenterId       String?
  clientId           String?
  projectId          String?
  contractId         String?
  paymentMethod      PaymentMethod?
  status             MovementStatus @default(PENDENTE)
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        FinancialCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenter      CostCenter?            @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  client          Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project         Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contract        Contract?              @relation(fields: [contractId], references: [id], onDelete: SetNull)
  receivable      AccountReceivable?
  payable         AccountPayable?
  cardInstallment CreditCardInstallment?
  investment      Investment?

  @@index([organizationId, type, status])
  @@index([organizationId, dueDate])
  @@map("financial_movements")
}

enum ReceivableStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

model AccountReceivable {
  id             String           @id @default(cuid())
  organizationId String
  clientId       String
  contractId     String?
  movementId     String?          @unique
  description    String
  amount         Decimal          @db.Decimal(14, 2)
  dueDate        DateTime
  paymentMethod  PaymentMethod?
  status         ReceivableStatus @default(PENDENTE)
  paidAt         DateTime?
  proofUrl       String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contract     Contract?          @relation(fields: [contractId], references: [id], onDelete: SetNull)
  movement     FinancialMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  reminders    PaymentReminder[]

  @@index([organizationId, status, dueDate])
  @@map("accounts_receivable")
}

enum PayableStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

model AccountPayable {
  id                 String        @id @default(cuid())
  organizationId     String
  movementId         String?       @unique
  description        String
  supplier           String?
  categoryId         String?
  costCenterId       String?
  amount             Decimal       @db.Decimal(14, 2)
  dueDate            DateTime
  recurring          Boolean       @default(false)
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?
  responsibleUserId  String?
  teamMemberId       String?
  status             PayableStatus @default(PENDENTE)
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenter   CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  movement     FinancialMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  teamMember   TeamMember?        @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueDate])
  @@index([teamMemberId])
  @@map("accounts_payable")
}

