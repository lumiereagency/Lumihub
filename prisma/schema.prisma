// =========================================================================
// INTEGRAÇÕES E LUMIHUB VAULT (Fase 14, 32, 33, 34)
// =========================================================================

enum IntegrationCategory {
  CALENDARIO
  COMUNICACAO
  FINANCEIRO
  IA
  ARMAZENAMENTO
  AUTOMACAO
  OUTROS
}

enum IntegrationProviderKey {
  GOOGLE_CALENDAR
  OUTLOOK_CALENDAR
  WHATSAPP_BUSINESS
  EMAIL_SMTP
  RESEND
  PIX
  ASAAS
  STRIPE
  MERCADO_PAGO
  OPENAI
  ANTHROPIC
  GOOGLE_GEMINI
  GOOGLE_DRIVE
  DROPBOX
  N8N
  MAKE
  ZAPIER
  WEBHOOK_CUSTOM
  CUSTOM_API
}

enum IntegrationStatus {
  CONECTADO
  PENDENTE
  ERRO
  EXPIRADO
  DESCONECTADO
}

model Integration {
  id                String                 @id @default(cuid())
  organizationId    String
  provider          IntegrationProviderKey
  category          IntegrationCategory
  status            IntegrationStatus      @default(DESCONECTADO)
  config            Json?
  connectedAt       DateTime?
  lastSyncAt        DateTime?
  lastUsedAt        DateTime?
  connectedByUserId String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User?                   @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
  credentials  IntegrationCredential[]
  webhooks     IntegrationWebhook[]
  logs         IntegrationLog[]

  @@unique([organizationId, provider])
  @@map("integrations")
}

// LUMIHUB VAULT — segredos sempre criptografados (AES-256-GCM), nunca em texto puro.
model IntegrationCredential {
  id             String    @id @default(cuid())
  integrationId  String
  label          String
  encryptedValue Bytes
  iv             Bytes
  authTag        Bytes
  maskedPreview  String
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  rotatedAt      DateTime?
  createdAt      DateTime  @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("integration_credentials")
}

model IntegrationWebhook {
  id             String   @id @default(cuid())
  organizationId String
  integrationId  String?
  name           String
  slug           String   @unique
  secretHash     String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration?     @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  logs         IntegrationLog[]

  @@map("integration_webhooks")
}

enum LogDirection {
  ENTRADA
  SAIDA
}

enum LogStatus {
  SUCESSO
  FALHA
  PENDENTE
}

model IntegrationLog {
  id             String       @id @default(cuid())
  organizationId String
  integrationId  String?
  webhookId      String?
  direction      LogDirection
  eventType      String
  payload        Json?
  status         LogStatus
  responseCode   Int?
  attempt        Int          @default(1)
  errorMessage   String?
  createdAt      DateTime     @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration?        @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  webhook      IntegrationWebhook? @relation(fields: [webhookId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("integration_logs")
}

// =========================================================================
// LUMI AI (Fase 16, 30, 31)
